#!/bin/sh
set -e

msg_file="$1"
commit_source="$2"

if [ "$commit_source" = "merge" ] || [ "$commit_source" = "squash" ]; then
  exit 0
fi

if grep -qi "\[skip-release-notes\]" "$msg_file"; then
  exit 0
fi

notes_file="docs/RELEASE_NOTES.md"
if [ ! -f "$notes_file" ]; then
  printf "# Release Notes\n\n" > "$notes_file"
fi

summary=$(grep -v '^[#]' "$msg_file" | sed '/^[[:space:]]*$/d' | head -n 1 | tr -d '\r')
if [ -z "$summary" ]; then
  summary="Update release notes"
fi

date=$(date "+%Y-%m-%d %H:%M")
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")

printf "## %s\n- %s (branch: %s)\n\n" "$date" "$summary" "$branch" >> "$notes_file"

git add "$notes_file"